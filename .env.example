# F1 News Bot configuration — copy to .env and fill in your values

# --- Telegram bot (publishing + admin) — from @BotFather ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=your_channel_id_here
TELEGRAM_ADMIN_ID=your_admin_id_here

# --- Telegram API (channel monitoring, Telethon user session) ---
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=your_phone_number_here

# --- Storage ---
# PostgreSQL lives on the Contabo VPS in every environment (see docs/REBUILD_PLAN.md)
DATABASE_URL=postgresql://f1_user:CHANGE_ME@contabo-host:5432/f1_news
REDIS_URL=redis://localhost:6379/0

# --- LLM (remote Ollama-compatible server) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=https://dev.offtech.by:8444/ollama
LLM_MODEL=qwen2.5:14b
LLM_EMBEDDING_MODEL=bge-m3:latest
LLM_API_KEY=ollama
LLM_MAX_TOKENS=512

# --- News sources ---
# Comma-separated lists
RSS_FEEDS=https://www.f1news.ru/export/news.xml,https://www.f1-world.ru/news/rssexp6.xml,https://feeds.bbci.co.uk/sport/formula1/rss.xml
TELEGRAM_CHANNELS=@f1channel1,@f1channel2

# --- Processing ---
CHECK_INTERVAL_MINUTES=30
MAX_POSTS_PER_HOUR=5
MIN_RELEVANCE_SCORE=0.3
MAX_NEWS_ITEMS_PER_CHECK=50

# --- Misc ---
TIMEZONE=Europe/Minsk
LOG_LEVEL=INFO
LOG_FILE=logs/f1_news_bot.log
DEBUG=false
